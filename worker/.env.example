# ============================================================
# Faza Studio — Video Render Worker
# ============================================================
# Copy ke .env dan isi nilai sebenarnya.
# Worker berjalan di luar Next.js (Railway / VM / Docker).

# === Redis (BullMQ queue + pub/sub progress) ===
# Format: redis://[:password@]host:port  atau rediss:// untuk TLS
REDIS_URL=redis://localhost:6379

# === Pexels (background footage) ===
PEXELS_API_KEY=

# === Cloudflare R2 (output video storage) ===
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# === Supabase (service-role: bypass RLS untuk update projects) ===
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# === Worker tuning ===
# Concurrency render (default 1 — FFmpeg CPU berat)
WORKER_CONCURRENCY=1
# Log level: debug | info | warn | error
LOG_LEVEL=info
