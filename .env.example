# ============================================================
# AutoContent Studio (ACS) — Environment Variables
# ============================================================

# === AI Provider (Primary: Groq) ===
# Dapatkan API key di https://console.groq.com
GROQ_API_KEY=
# Model untuk SCRIPT (tugas berat). Pengganti llama-3.3-70b-versatile yang
# dihentikan Groq 16 Agustus 2026.
GROQ_MODEL_MAIN=openai/gpt-oss-120b
# Model untuk CAPTION / IDE / TERJEMAHAN / KLASIFIKASI (tugas ringan).
# Pengganti llama-3.1-8b-instant yang dihentikan Groq 16 Agustus 2026.
GROQ_MODEL_LIGHT=openai/gpt-oss-20b
# Opsional: effort reasoning model gpt-oss (low|medium|high).
# Kosong = otomatis per tier (main=medium, light=low).
GROQ_REASONING_EFFORT=
# Opsional (legacy): model lama. DIABAIKAN bila isinya model yang sudah dihentikan.
GROQ_MODEL=

# === AI Provider (Fallback: OpenRouter — opsional tapi disarankan) ===
# Dapatkan API key di https://openrouter.ai
# Dipakai otomatis bila Groq gagal: 404 model_not_found, 429/kuota, 5xx,
# timeout, error jaringan, atau respons bukan JSON valid.
OPENROUTER_API_KEY=
# Default: openai/gpt-4o-mini (≈$0.15 / 1J input, $0.60 / 1J output).
OPENROUTER_MODEL=openai/gpt-4o-mini
# false = matikan perpindahan otomatis ke OpenRouter.
AI_FALLBACK_ENABLED=true
# Opsional: timeout per provider (ms). Default Groq 15000, OpenRouter 30000.
AI_GROQ_TIMEOUT_MS=
AI_OPENROUTER_TIMEOUT_MS=

# === App ===
APP_URL=http://localhost:3000
# Domain untuk same-origin auth check (contoh: APP_DOMAIN=https://acs.vercel.app)
APP_DOMAIN=

# === API Security ===
# API Secret Key untuk melindungi endpoint API
# Request dari frontend (same-origin) TIDAK perlu API key — otomatis diizinkan
# Request dari luar / integrasi eksternal WAJIB mengirim header: X-API-Key: <nilai ini>
API_SECRET_KEY=

# === Redis (untuk rate limiting) ===
# Self-hosted Redis: REDIS_URL=redis://localhost:6379
# Atau Upstash: UPSTASH_REDIS_REST_URL= dan UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# === TTS (Text-to-Speech) Provider ===
# Google: gratis tanpa key (fallback default)
# ElevenLabs: https://elevenlabs.io
ELEVENLABS_API_KEY_1=
ELEVENLABS_VOICE_ID_1=
ELEVENLABS_API_KEY_2=
ELEVENLABS_VOICE_ID_2=
# Cartesia: https://cartesia.ai
CARTESIA_API_KEY_1=
CARTESIA_VOICE_ID_1=
CARTESIA_API_KEY_2=
CARTESIA_VOICE_ID_2=

# === Supabase (untuk persistence + auth — pakai project Supabase Faza Studio) ===
# Project URL: Settings > API > Project URL
# Anon key: Settings > API > anon/public key
# Service role key: Settings > API > service_role key (RAHASIA — hanya untuk backend)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# === TrendTracker — Produk trending untuk Affiliate category ===
TRENDTRACKER_API_URL=https://trendtrackerid.vercel.app
# === Midtrans (untuk billing / pembayaran — target pasar Indonesia) ===
# Dapatkan key di https://dashboard.midtrans.com > Settings > Access Keys
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# false = Sandbox, true = Production
MIDTRANS_IS_PRODUCTION=false
# Client key untuk Snap.js di browser
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
# Public flag (identik dgn MIDTRANS_IS_PRODUCTION) untuk dipakai di sisi browser (Snap.js URL)
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false

# === Cloudflare R2 (penyimpanan video hasil render) ===
# Video diunggah ke R2 (bukan Supabase Storage). Supabase tetap untuk projects/usage/audio/subtitle.
# - Account ID: Dashboard Cloudflare > R2 > buka bucket > lihat account id
# - Access/Secret Key: R2 Overview > Manage R2 API Tokens
# - R2_PUBLIC_URL: custom domain atau endpoint public bucket (tanpa trailing slash)
# Struktur key: "free/{identityKey}/{timestamp}.mp4" | "premium/{identityKey}/{timestamp}.mp4"
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# === PostHog (product analytics) ===
# Project API key: Project Settings > Project API Key (public — veilig samen met web)
# Hosting: https://app.posthog.com of https://eu.i.posthog.com voor EU-residentie
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com